<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
	<metadata>
		<Version>$(Version)</Version>
		<PackageVersion>$(PackageVersion)</PackageVersion>

		<Authors>$(Authors)</Authors>
		<Company>$(Company)</Company>
		<PackageId>$(Id)</PackageId>
		<Title>$(Id)</Title>

		<Description>$(Description)</Description>
		<PackageTags>Soubhik, Nandy, Azure, Storage, Table, Blob</PackageTags>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<PackageProjectUrl>https://github.com/JicoDotNet/DataAccess.AzureStorage</PackageProjectUrl>
		<RepositoryUrl>https://github.com/JicoDotNet/DataAccess.AzureStorage</RepositoryUrl>

		<RepositoryType>git</RepositoryType>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</metadata>

	<files>
		<file src="..\build\netstandard2.0\DataAccess.AzureStorage.dll" target="lib\netstandard2.0\" />
		<file src="..\build\netstandard2.1\DataAccess.AzureStorage.dll" target="lib\netstandard2.1\" />
	</files>
</package>
